                      },
                      "kind": "tiered_energy",
                      "limits": "period"
                    },
                    "night": {
                      "bands": [
                        "Night"
                      ],
                      "blocks": {
                        "standard": {
                          "from_kwh": "0",
                          "price": "0.2802",
                          "upto_kwh": "2000"
                        },
                        "threshold": {
                          "from_kwh": "2000",
                          "price": "0.3156"
                        }
                      },
                      "kind": "tiered_energy",
                      "limits": "period"
                    }
                  }
                },
                "percent": "-26"
              },
              "levy": {
                "amount": "0.5559",
