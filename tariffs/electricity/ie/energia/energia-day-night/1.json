                "share": "days_in_period"
              },
              "standing": {
                "kind": "per_day"
              }
            }
          },
          "percent": "$country.vat_percent"
        }
      }
    }
  },
  "inputs": {
    "bill_start_month": {
      "default": 1,
      "max": 12,
      "min": 1,
      "type": "integer"
    }
