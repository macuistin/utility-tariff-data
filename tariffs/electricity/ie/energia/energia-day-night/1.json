            "kind": "sum",
            "of": {
              "energy": {
                "kind": "adjust",
                "name": "Discount",
                "of": {
                  "kind": "sum",
                  "of": {
                    "day": {
                      "bands": [
                        "Day"
                      ],
                      "blocks": {
                        "standard": {
                          "from_kwh": "0",
