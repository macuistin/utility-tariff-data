{
  "schema": 1,
  "country": "SG",
  "currency": "SGD",
  "timezone": "Asia/Singapore",
  "vat_percent": "9",
  "availability": "available",
  "inputs": {
    "bill_start_day": {
      "default": 1,
      "max": 28,
      "min": 1,
      "type": "integer"
    }
  },
  "bill": {
    "period": {
      "rule": "monthly",
      "start_day": "$input.bill_start_day"
    },
    "total": {
      "kind": "tax",
      "mode": "added",
      "name": "GST",
      "of": {
        "kind": "sum",
        "of": {
          "energy": {
            "kind": "energy_by_band",
            "round_bands": true
          },
          "standing": {
            "kind": "per_day"
          }
        }
      },
      "percent": "$country.vat_percent"
    }
  },
  "providers": {}
}
